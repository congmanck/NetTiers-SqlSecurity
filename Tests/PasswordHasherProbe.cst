<%@ CodeTemplate Src="../TemplateLib/CommonSqlCode.cs" Inherits="MoM.Templates.CommonSqlCode" Language="C#" TargetLanguage="Text" CompilerVersion="v3.5" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Assembly Name="SchemaExplorer.SqlSchemaProvider" %>
<%@ Assembly Name="System.Design" %>
<%@ Register Name="ConfigProbe" Template="../VisualStudio/App.config.2005.cst" MergeProperties="False" %>
<%@ Register Name="ProjectProbe" Template="../VisualStudio/vsnet2005.project.cst" MergeProperties="False" %>
<%@ Import Namespace="System" %>
<%@ Import Namespace="System.IO" %>
<%@ Import Namespace="System.Xml" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="MoM.Templates" %>
<%@ Property Name="TrialOutput" Type="System.String" Optional="False" %>
<%
if (!Directory.Exists(TrialOutput)) throw new InvalidOperationException("Trial output must already exist.");
CodeSmith.Engine.CodeTemplateCompiler compiler = new CodeSmith.Engine.CodeTemplateCompiler(Path.Combine(Path.GetDirectoryName(CodeTemplateInfo.FullPath), "..\\NetTiers.cst"));
compiler.Compile();
if (compiler.Errors.HasErrors) {
    System.Text.StringBuilder errors = new System.Text.StringBuilder();
    foreach (System.CodeDom.Compiler.CompilerError error in compiler.Errors) if (!error.IsWarning) errors.AppendLine(error.ErrorText);
    throw new Exception(errors.ToString());
}
CodeSmith.Engine.CodeTemplate master = compiler.CreateInstance();
if (master.GetType().GetProperty("DotNetVersion").GetValue(master, null).ToString() != "v4_8") throw new Exception("Wrong master default.");
if ((bool)master.GetType().GetProperty("ExecuteSql").GetValue(master, null)) throw new Exception("Unsafe test default.");
if ((bool)master.GetType().GetProperty("IncludePasswordHasher").GetValue(master, null)) throw new Exception("Password helper must be opt-in.");
System.Reflection.MethodInfo emit = master.GetType().GetMethod("GeneratePasswordHasher", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
foreach (string ns in new string[] { "Accounts.Data", "PortingTrial.Data" })
{
    string output = Path.Combine(TrialOutput, ns);
    string file = Path.Combine(output, "Security\\PasswordHasher.cs");
    master.SetProperty("IncludePasswordHasher", false);
    if ((bool)emit.Invoke(master, new object[] { output, ns }) || File.Exists(file)) throw new Exception("Disabled option emitted a file.");
    master.SetProperty("IncludePasswordHasher", true);
    if (!(bool)emit.Invoke(master, new object[] { output, ns })) throw new Exception("Missing emitted file.");
    string first = File.ReadAllText(file);
    if (!first.Contains("namespace " + ns + ".Security") || first.Contains("PasswordStoragePolicy") || first.Contains("__DAL_NAMESPACE__")) throw new Exception("Asset is not generic.");
    emit.Invoke(master, new object[] { output, ns });
    if (File.ReadAllText(file) != first) throw new Exception("Regeneration changed the hasher.");
    master.SetProperty("IncludePasswordHasher", false);
    emit.Invoke(master, new object[] { output, ns });
    if (File.ReadAllText(file) != first) throw new Exception("Disabling deleted or changed an existing helper.");
    Response.WriteLine("PASSWORD_ASSET_PASS " + ns);
}
System.Reflection.MethodInfo integration = master.GetType().GetMethod("GenerateHocPhiPasswordIntegration", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
if ((bool)master.GetType().GetProperty("IncludeHocPhiPasswordIntegration").GetValue(master, null)) throw new Exception("Integration must be opt-in.");
string hocphiData = Path.Combine(TrialOutput, "HocPhiIntegration\\Accounts.Data");
string hocphiSql = Path.Combine(TrialOutput, "HocPhiIntegration\\Accounts.Data.SqlClient");
if ((bool)integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Accounts.Data" }) || Directory.Exists(hocphiData)) throw new Exception("Disabled integration wrote output.");
master.SetProperty("IncludeHocPhiPasswordIntegration", true);
master.SetProperty("IncludePasswordHasher", false);
bool namespaceRejected = false;
try { integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Other.Data" }); }
catch (System.Reflection.TargetInvocationException error) { namespaceRejected = error.InnerException is InvalidOperationException; }
if (!namespaceRejected) throw new Exception("Integration namespace guard failed.");
integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Accounts.Data" });
if (!(bool)master.GetType().GetProperty("IncludePasswordHasher").GetValue(master, null)) throw new Exception("Integration did not enable hasher.");
string policyFile = Path.Combine(hocphiData, "Security\\PasswordStoragePolicy.user.cs");
string providerFile = Path.Combine(hocphiSql, "SqlTaiKhoanProvider.PasswordSecurity.user.cs");
if (!File.Exists(policyFile) || !File.ReadAllText(providerFile).Contains("CompareExchangePassword")) throw new Exception("Missing integration files.");
string policyBefore = File.ReadAllText(policyFile);
string providerBefore = File.ReadAllText(providerFile);
integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Accounts.Data" });
if (File.ReadAllText(policyFile) != policyBefore || File.ReadAllText(providerFile) != providerBefore) throw new Exception("Regeneration changed integration.");
string previousAsset = Path.Combine(Path.GetDirectoryName(CodeTemplateInfo.FullPath), "..\\SecuritySource\\HocPhi\\Previous\\SqlTaiKhoanProvider.PasswordSecurity.user.cs.txt");
File.WriteAllText(providerFile, File.ReadAllText(previousAsset));
integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Accounts.Data" });
if (File.ReadAllText(providerFile) != providerBefore) throw new Exception("Known previous TLS guard was not upgraded.");
string[] backups = Directory.GetFiles(hocphiSql, "*.bak");
if (backups.Length != 1 || Path.GetFileName(backups[0]).Contains(".user.")) throw new Exception("Unsafe integration backup name.");
Response.WriteLine("HOCPHI_TLS_UPGRADE_PASS backup-and-merge");
File.AppendAllText(providerFile, "\r\n// local customization\r\n");
bool customRejected = false;
try { integration.Invoke(master, new object[] { hocphiData, hocphiSql, "Accounts.Data" }); }
catch (System.Reflection.TargetInvocationException error) { customRejected = error.InnerException is InvalidOperationException; }
if (!customRejected || !File.ReadAllText(providerFile).Contains("local customization")) throw new Exception("Custom file overwritten.");
File.WriteAllText(providerFile, providerBefore);
master.SetProperty("IncludeHocPhiPasswordIntegration", false);
Response.WriteLine("HOCPHI_INTEGRATION_PASS fresh-output/repeat/opt-in/namespace/custom-preservation");
master.Dispose();
Response.WriteLine("MASTER_TEMPLATE_COMPILE_PASS; default v4_8, ExecuteSql=False; master not rendered");
CodeSmith.Engine.CodeTemplate config = base.CreateTemplate<ConfigProbe>();
config.SetProperty("DotNetVersion", DotNetFrameworkVersion.v4_8);
config.SetProperty("IsWebConfig", false);
config.SetProperty("DALNameSpace", "FrameworkTrial.Data");
config.SetProperty("ConnectionString", "Data Source=(local);Initial Catalog=FrameworkTrial;Integrated Security=True");
config.SetProperty("FactoryType", "FrameworkTrial.Entities.EntityFactory");
config.SetProperty("WebServiceUrl", "https://example.invalid/service");
config.SetProperty("ProviderInvariantName", "System.Data.SqlClient");
config.SetProperty("NetTiersSqlProvider", true);
config.SetProperty("EntLibVersion", EntLibVersion.v3_1);
string configText = config.RenderToString();
XmlDocument configXml = new XmlDocument(); configXml.LoadXml(configText);
if (configXml.SelectSingleNode("/configuration/startup/supportedRuntime/@sku").Value != ".NETFramework,Version=v4.8") throw new Exception("Wrong runtime configuration.");
XmlNode autoTls = configXml.SelectSingleNode("/configuration/appSettings/add[@key='AutoUpgradeSqlEncryption']/@value");
if (autoTls == null || autoTls.Value != "true") throw new Exception("Missing automatic TLS upgrade default.");
if (configText != config.RenderToString()) throw new Exception("Config generation changed on repeat.");
File.WriteAllText(Path.Combine(TrialOutput, "FrameworkTrial.config"), configText);
config.Dispose();
Response.WriteLine("CONFIG_FRAMEWORK_PASS v4.8; repeat generation identical");
if (GetDotNetFrameworkString(DotNetFrameworkVersion.v4_8) != "4.8") throw new Exception("Framework mapping failed.");
if ((int)DotNetFrameworkVersion.v4_5 != 4 || (int)DotNetFrameworkVersion.v4_8 != 5) throw new Exception("Enum compatibility failed.");
foreach (bool includeHasher in new bool[] { false, true })
foreach (string role in new string[] { "Entities", "Data", "SqlClient", "Services" })
foreach (DotNetFrameworkVersion version in new DotNetFrameworkVersion[] { DotNetFrameworkVersion.v4, DotNetFrameworkVersion.v4_5, DotNetFrameworkVersion.v4_8 })
{
    if (!IsDotNetFramework4OrLater(version)) throw new Exception("Feature selection failed.");
    CodeSmith.Engine.CodeTemplate project = base.CreateTemplate<ProjectProbe>();
    string templateSource = File.ReadAllText(Path.Combine(Path.GetDirectoryName(CodeTemplateInfo.FullPath), "..\\VisualStudio\\vsnet2005.project.cst"));
    foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(templateSource, "<%@ Property Name=\"([^\"]+)\" Type=\"System.String\""))
    {
        string propertyName = match.Groups[1].Value;
        project.SetProperty(propertyName, propertyName.EndsWith("Guid") ? "813078E1-823F-4B42-B509-B53B06BB2F91" : "FrameworkTrial");
    }
    project.SetProperty("IncludePasswordHasher", includeHasher);
    project.SetProperty("DotNetVersion", version);
    project.SetProperty("VisualStudioVersion", VSNetVersion.v2013);
    project.SetProperty("ProviderInvariantName", "System.Data.SqlClient");
    project.SetProperty("EntLibVersion", EntLibVersion.v3_1);
    project.SetProperty("SourceDatabase", new DatabaseSchema(new SqlSchemaProvider(), ""));
    project.SetProperty("SourceTables", new TableSchemaCollection());
    project.SetProperty("SourceViews", new ViewSchemaCollection());
    project.SetProperty("EnumTables", new TableSchemaCollection());
    project.SetProperty("IncludeBll", role == "Entities");
    project.SetProperty("IncludeDALBase", role == "Data");
    project.SetProperty("IncludeSqlClient", role == "SqlClient");
    project.SetProperty("IncludeComponents", role == "Services");
    project.SetProperty("ComponentPattern", ComponentPatternType.ServiceLayer);
    project.SetProperty("BLLNameSpace", "FrameworkTrial.Entities");
    project.SetProperty("BLLGuid", "813078E1-823F-4B42-B509-B53B06BB2F91");
    project.SetProperty("NameSpace", "FrameworkTrial");
    project.SetProperty("OutputDirectory", TrialOutput);
    project.SetProperty("LibraryPath", "..\\References");
    string first = project.RenderToString();
    string second = project.RenderToString();
    project.Dispose();
    if (first != second) throw new Exception("Second generation changed output.");
    XmlDocument xml = new XmlDocument(); xml.LoadXml(first);
    XmlNode target = xml.SelectSingleNode("//*[local-name()='TargetFrameworkVersion']");
    if (target == null || target.InnerText != "v4.8") throw new Exception("Wrong generated target.");
    bool hasInclude = first.Contains("Security\\PasswordHasher.cs");
    if (hasInclude != (includeHasher && role == "Data")) throw new Exception("Incorrect password project include: " + role);
    if (!first.Contains("**\\*.user.*")) throw new Exception("Custom extension include missing.");
    if (first.Contains("Security\\SqlEncryptionUpgrade.cs") != (role == "Data")) throw new Exception("Wrong automatic TLS source registration.");
    if (!first.Contains("System.ComponentModel.DataAnnotations")) throw new Exception("Missing modern framework reference.");
    File.WriteAllText(Path.Combine(TrialOutput, role + "-" + version.ToString() + "-" + includeHasher + ".csproj"), first);
    Response.WriteLine("PROJECT_FRAMEWORK_PASS " + role + " " + version.ToString() + " -> v4.8; repeat generation identical");
}
%>
